{
  "name": "@alexpricedev/billet-analytics",
  "version": "0.1.0",
  "description": "First-party, cookie-free, anonymous-by-default server-side analytics for Billet apps. Bun + Postgres.",
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./migration": {
      "types": "./src/migration.ts",
      "import": "./src/migration.ts",
      "default": "./src/migration.ts"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "biome check .",
    "lint:write": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "check": "bun run lint && bun run typecheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "author": "Alex Price",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexpricedev/billet-analytics.git"
  },
  "bugs": {
    "url": "https://github.com/alexpricedev/billet-analytics/issues"
  },
  "homepage": "https://github.com/alexpricedev/billet-analytics#readme",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "first-party",
    "postgres",
    "billet",
    "bun"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "^5.9.0"
  }
}
